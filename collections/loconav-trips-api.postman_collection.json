                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"trip\": {\n    \"vehicle\": {\n      \"number\": \"VT_MOCKER2\"\n    },\n    \"customFields\": {},\n    \"createNewVehicleRoute\": true,\n    \"newVehicleRouteName\": \"test_test_route_12\",\n    \"shouldStartAt\": 1706264834,\n    \"uniqueId\": \"test_01\",\n    \"expectedDistance\": 30,\n    \"tripDelayAlertsEnabled\": true,\n    \"sourceName\": \"Gurugram\",\n    \"shouldExpireOldTrips\": false,\n    \"source\": {\n      \"address\": \"test_address\",\n      \"coordinates\": \"10.01,10.01\",\n      \"radius\": 10,\n      \"eta\": 1706285834,\n      \"etd\": 1706287834\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
